{
  "openapi": "3.1.0",
  "info": {
    "title": "PF Garage Door API",
    "version": "1.0.0",
    "description": "REST API contract used by the Home Assistant PF Garage Door integration."
  },
  "servers": [
    {
      "url": "http://{host}",
      "description": "Garage door controller",
      "variables": {
        "host": {
          "default": "garage-door.local",
          "description": "Controller hostname or IP address, optionally including a port."
        }
      }
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/api/v1/status": {
      "get": {
        "operationId": "getGarageDoorStatus",
        "summary": "Get garage door status",
        "description": "Returns the current reported door position and controller details.",
        "responses": {
          "200": {
            "description": "Current garage door status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                },
                "example": {
                  "name": "Garage Door",
                  "serial_number": "123456789",
                  "firmware": "1.0.0",
                  "position": 0,
                  "obstruction": false
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "5XX": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/v1/cover/position": {
      "put": {
        "operationId": "setGarageDoorPosition",
        "summary": "Set garage door position",
        "description": "Requests a target opening percentage. Zero is fully closed and 100 is fully open. The command response acknowledges acceptance; read the status endpoint to observe reported progress.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PositionCommand"
              },
              "example": {
                "position": 65
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Position command accepted."
          },
          "400": {
            "description": "The request body is invalid or the position is outside the allowed range."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "5XX": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/v1/cover/stop": {
      "post": {
        "operationId": "stopGarageDoor",
        "summary": "Stop garage door movement",
        "description": "Requests that the controller stop current door movement.",
        "responses": {
          "204": {
            "description": "Stop command accepted."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "5XX": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/v1/subscriptions": {
      "put": {
        "operationId": "registerGarageDoorStatusSubscription",
        "summary": "Register or update a status subscription",
        "description": "Registers a callback URL for status changes, or updates the callback URL for an existing subscription. This operation is idempotent for the supplied subscription ID. Each successful request renews the controller-managed six-hour lease; clients should renew at least hourly. The controller expires subscriptions that are not renewed before their lease expires.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubscriptionRequest"
              },
              "example": {
                "subscription_id": "abcdef0123456789",
                "callback_url": "http://homeassistant.local:8123/api/webhook/0123456789abcdef"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Subscription registered or updated."
          },
          "400": {
            "description": "The callback URL is invalid."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "5XX": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "delete": {
        "operationId": "removeGarageDoorStatusSubscription",
        "summary": "Remove a status subscription",
        "description": "Removes the subscription. Deleting a subscription that does not exist is successful, making this operation idempotent.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubscriptionId"
              },
              "example": {
                "subscription_id": "abcdef0123456789"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Subscription removed or already absent."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "5XX": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    }
  },
  "webhooks": {
    "garageDoorStatusUpdate": {
      "post": {
        "operationId": "pushGarageDoorStatus",
        "summary": "Push garage door status to Home Assistant",
        "description": "After a subscription is registered, the controller sends the same status payload as GET /api/v1/status to the callback URL whenever the status changes. Home Assistant generates a random webhook ID and sends a local URL of the form http://<home-assistant-host>:8123/api/webhook/{webhook_id}. The webhook ID is a secret token, and the endpoint is restricted to the local network.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Status"
              },
              "example": {
                "name": "Garage Door",
                "serial_number": "123456789",
                "firmware": "1.0.0",
                "position": 35,
                "obstruction": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Status accepted and Home Assistant updated."
          },
          "400": {
            "description": "The request body is not valid JSON."
          },
          "422": {
            "description": "The status payload is invalid or its serial number does not match the configured controller."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "Status": {
        "type": "object",
        "required": [
          "name",
          "serial_number",
          "firmware",
          "position",
          "obstruction"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Human-readable controller or door name."
          },
          "serial_number": {
            "type": "string",
            "minLength": 1,
            "description": "Stable, unique controller serial number."
          },
          "firmware": {
            "type": "string",
            "description": "Controller firmware version."
          },
          "position": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Reported opening percentage: 0 is closed and 100 is open."
          },
          "obstruction": {
            "type": "boolean",
            "description": "Whether an obstruction is currently detected."
          }
        }
      },
      "PositionCommand": {
        "type": "object",
        "required": ["position"],
        "properties": {
          "position": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Target opening percentage: 0 is closed and 100 is open."
          }
        },
        "additionalProperties": false
      },
      "SubscriptionRequest": {
        "type": "object",
        "required": [
          "subscription_id",
          "callback_url"
        ],
        "properties": {
          "subscription_id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable subscription identifier generated by the client."
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "Local Home Assistant webhook URL that receives status update POST requests."
          }
        },
        "additionalProperties": false
      },
      "SubscriptionId": {
        "type": "object",
        "required": [
          "subscription_id"
        ],
        "properties": {
          "subscription_id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable subscription identifier to remove."
          }
        },
        "additionalProperties": false
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid HTTP Basic credentials."
      },
      "ServerError": {
        "description": "The controller encountered an internal error."
      }
    }
  }
}
